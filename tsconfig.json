{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"ignoreDeprecations": "6.0",
		"baseUrl": ".",
		"paths": {
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"],
			"#lib": ["./src/lib"],
			"#lib/*": ["./src/lib/*"],
			"src/lib": ["./src/lib"],
			"src/lib/*": ["./src/lib/*"],
			"src/lib/components": ["./src/lib/components"],
			"src/lib/components/*": ["./src/lib/components/*"],
			"src/lib/utils": ["./src/lib/utils.ts"],
			"src/lib/hooks": ["./src/lib/hooks"],
			"src/lib/hooks/*": ["./src/lib/hooks/*"]
		}
	},
	"include": ["src", "vite.config.ts"]
}
